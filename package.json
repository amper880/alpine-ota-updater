{
  "name": "alpine-ota-updater",
  "version": "0.2.0",
  "description": "Over-the-air firmware updater for MeshCore repeater and room server nodes (BLE DFU / WiFi OTA).",
  "author": "Amper",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/dev.mjs --preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm test && npm run build",
    "catalog": "node scripts/build-catalog.mjs",
    "proxy:deploy": "npx wrangler@4 deploy --config proxy/wrangler.toml"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
