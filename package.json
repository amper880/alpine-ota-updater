{
  "name": "alpine-ota-updater",
  "version": "0.5.0",
  "description": "Over-the-air firmware updater app for MeshCore repeater and room server nodes (Bluetooth DFU / WiFi OTA).",
  "author": "Amper",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm test && npm run build",
    "catalog": "node scripts/build-catalog.mjs",
    "icons": "tauri icon src-tauri/icons/icon-manifest.json",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build --apk",
    "brand": "node scripts/make-brand-assets.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@mnlphlp/plugin-blec": ">=0.17.0 <0.19.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-http": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0"
  }
}
