{
  "$comment": "Firmware sources. See docs/ADDING_A_SOURCE.md for the meaning of each field.",
  "sources": [
    {
      "id": "official",
      "name": "MeshCore",
      "description": "Official MeshCore releases.",
      "repo": "meshcore-dev/MeshCore",
      "homepage": "https://github.com/meshcore-dev/MeshCore",
      "roleTags": {
        "repeater": "^repeater-v",
        "room-server": "^room-server-v",
        "companion": "^companion-v"
      },
      "versionPattern": "v?(?<version>\\d+(?:\\.\\d+)+[a-z]?)",
      "assetPattern": "^(?<board>.+?)_(?<role>repeater|room_server|companion_radio_ble)-v[^-]+-[0-9a-f]+(?<merged>-merged)?\\.(?<ext>zip|bin)$",
      "platforms": [
        "nrf52",
        "esp32"
      ],
      "wifiOta": "meshcore"
    },
    {
      "id": "powersaving",
      "name": "PowerSaving",
      "description": "MeshCore with power-saving and experimental features by IoTThinks.",
      "repo": "IoTThinks/EasySkyMesh",
      "homepage": "https://github.com/IoTThinks/EasySkyMesh",
      "tagPattern": "^PowerSaving",
      "versionPattern": "PowerSaving(?<version>[0-9][0-9.]*)",
      "assetPattern": "^(?<board>.+?)_(?<role>repeater|room_server|companion_radio_ble)-PowerSaving[0-9.]+(?:-(?<variant>upgrade|freshInstall))?(?<merged>-merged)?\\.(?<ext>zip|bin)$",
      "exclude": [
        "freshInstall"
      ],
      "platforms": [
        "nrf52",
        "esp32"
      ],
      "wifiOta": "meshcore"
    },
    {
      "id": "zephcore",
      "name": "ZephCore",
      "description": "MeshCore-compatible firmware built on Zephyr RTOS by liquidraver.",
      "repo": "liquidraver/ZephCore",
      "homepage": "https://github.com/liquidraver/ZephCore",
      "tagPattern": "-zephcore$",
      "versionPattern": "^(?<version>[0-9][0-9.]*[a-z]?)",
      "assetPattern": "^(?<board>.+?)(?:-(?:esp32s3-procpu|esp32-procpu|esp32c6-hpcore|esp32c3))?-(?<role>repeater|room_server|roomserver|room-server|companion)(?:-(?<flavor>noscreen))?-[0-9a-f]{6,}(?:-(?<variant>update))?(?<merged>-merged)?\\.(?<ext>zip|bin)$",
      "platforms": [
        "nrf52",
        "esp32"
      ],
      "otaVariants": {
        "esp32": "update"
      },
      "wifiOta": "zephcore",
      "boardAliases": {
        "gat562_30s": "gat56230smeshkit",
        "heltec_t114_noscreen": "heltect114withoutdisplay",
        "heltec_wifi_lora32_v3": "heltecv3",
        "heltec_wifi_lora32_v4": "heltecv4",
        "heltec_wifi_lora32_v4_r8": "heltecv4r8",
        "heltec_wireless_tracker_v2": "heltectrackerv2",
        "ikoka_nano_30dbm": "ikokananonrf30dbm",
        "lilygo_t3s3": "lilygot3s3sx1262",
        "muziworks_r1neo": "r1neo",
        "promicro_sx1262": "promicro",
        "rak3401_1watt": "rak3401",
        "xiao_esp32c3": "xiaoc3",
        "xiao_esp32s3": "xiaos3",
        "xiao_nrf52840": "xiaonrf52"
      }
    },
    {
      "id": "wiol1pro",
      "name": "Wio Tracker L1 Pro",
      "description": "MeshCore companion builds with an extended UI for the Seeed Wio Tracker L1 (Pro / e-ink), by sosprz.",
      "repo": "sosprz/Meshcore-Wio-Tracker-L1-Pro",
      "homepage": "https://github.com/sosprz/Meshcore-Wio-Tracker-L1-Pro",
      "tagPattern": "^v\\d",
      "versionPattern": "v?(?<version>\\d+(?:\\.\\d+)+)",
      "assetPattern": "^(?<board>.+?)_(?<role>repeater|room_server|companion_radio_ble)-v[^-]+-[0-9a-f]+(?<merged>-merged)?\\.(?<ext>zip|bin)$",
      "platforms": [
        "nrf52"
      ]
    },
    {
      "id": "cairn",
      "name": "Cairn",
      "description": "MeshCore companion firmware with its own UI and compact repeaters, by cvhviz. nRF52 images are published as .uf2; the app converts them for Bluetooth.",
      "repo": "cvhviz/CAIRN",
      "homepage": "https://github.com/cvhviz/CAIRN",
      "tagPattern": "^cairn-v\\d",
      "versionPattern": "cairn-v(?<version>\\d+)",
      "assetPattern": "^MeshCore-(?<board>[A-Za-z0-9]+?)(?<role2>RoomServer)?-Cairn\\d+-\\d{4}-\\d{2}-\\d{2}(?:-(?<role>ble|repeater|usb))?\\.(?<ext>uf2)$",
      "defaultRole": "companion",
      "platforms": [
        "nrf52"
      ],
      "boardAliases": {
        "GAT562MeshKit": "gat56230smeshkit",
        "GAT562TrackerPro": "gat562meshtrackerpro",
        "GAT562Watch13": "gat562meshwatch13",
        "TImpulsePlus": "lilygotimpulseplus",
        "WioL1": "wiotrackerl1",
        "WioL1Pro": "wiotrackerl1",
        "WioL1Eink": "wiotrackerl1eink"
      },
      "notes": "Cairn's ESP32 images are left out: they update over WiFi only through Cairn's own updater, and switching from MeshCore needs the -full.bin over USB."
    }
  ]
}
